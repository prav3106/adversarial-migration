# Copy this file to .env and fill in values. Never commit .env.

# Path to the cobc compiler binary (default: cobc, must be on PATH)
COBC_BIN=cobc

# Path to the cobcrun runner binary (default: cobcrun)
COBCRUN_BIN=cobcrun

# Working directory for compiling/running COBOL programs
LEGACY_SOURCE_DIR=legacy_source

# Directory where golden outputs are written
GOLDEN_OUTPUT_DIR=golden_master/outputs

# Prosecutor budget: total inputs tried per program per run
PROSECUTOR_BUDGET=500

# Minimum samples per boundary class
PROSECUTOR_MIN_PER_CLASS=5

# Max fix attempts before NEEDS_HUMAN_REVIEW
MAX_FIX_ATTEMPTS=3
